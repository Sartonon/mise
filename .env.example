# Copy this file to `.env` (which git ignores) and change the values if you need to.
# drizzle-kit reads `.env` by itself. On Vercel, these are set in the project's settings instead.

# Where the database is. Locally, a SQLite file in the project folder (git ignores *.db).
# In production, a Turso database: libsql://<database>-<account>.turso.io
DATABASE_URL=file:local.db

# Only needed for Turso (a remote database). Leave it empty for a local file.
DATABASE_AUTH_TOKEN=
