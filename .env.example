# The env vars the app needs. Copy this file to `.env` (`cp .env.example .env`) and fill it in.
# `.env` is in .gitignore, so what you put there is never committed; this file is, so it holds
# no real values. The dev server and drizzle-kit both read `.env`; on Vercel, the project's
# environment variables settings set them instead.

# Where the database is. Locally, a SQLite file next to package.json (git ignores `*.db`).
DATABASE_URL=file:local.db

# Only for a hosted Turso database (step 27). Leave it empty for a local file.
DATABASE_AUTH_TOKEN=
