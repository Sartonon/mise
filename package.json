{
  "name": "mise",
  "version": "0.1.0",
  "private": true,
  "description": "Recipe & meal planner — a step-by-step learning project",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "lint:secrets": "secretlint \"**/*\"",
    "knip": "knip",
    "size": "node scripts/bundle-size/size.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "^5.27.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "colorjs.io": "^0.7.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "7.1.1",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  }
}
